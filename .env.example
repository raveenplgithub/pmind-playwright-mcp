# Browser Settings
BROWSER_HEADLESS=false
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=720
# Use semicolon (;) as separator for browser args to avoid comma conflicts
BROWSER_ARGS=--start-maximized;--no-sandbox;--disable-setuid-sandbox;--disable-infobars;--window-position=0,0;--disable-blink-features=AutomationControlled;--disable-dev-shm-usage

# Context Settings
CONTEXT_LOCALE=en-US
CONTEXT_TIMEZONE=America/New_York
CONTEXT_PERMISSIONS=geolocation,notifications
CONTEXT_COLOR_SCHEME=light
CONTEXT_ACCEPT_DOWNLOADS=true

# Timeouts (in milliseconds)
TIMEOUT_DEFAULT=30000
TIMEOUT_NAVIGATION=60000
TIMEOUT_PAGE_LOAD_CHECK=5000
TIMEOUT_NETWORK_IDLE=5000

# Screenshot Settings
SCREENSHOTS_DIRECTORY=~/.pmind-playwright-mcp/screenshots
SCREENSHOTS_TIMESTAMP_FORMAT=%Y%m%d_%H%M%S

# Stealth Settings
STEALTH_ENABLED=true

# Mobile Defaults
MOBILE_DEFAULT_DEVICE=iPhone 13

# Logging
LOGGING_LEVEL=INFO
LOGGING_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Video Recording Settings
VIDEO_DIRECTORY=~/.pmind-playwright-mcp/videos
VIDEO_SIZE_WIDTH=1280
VIDEO_SIZE_HEIGHT=720